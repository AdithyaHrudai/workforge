# --- Database (PostgreSQL — e.g. Neon / Supabase / RDS) ---
# Pooled connection for the app at runtime (serverless-safe).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection for migrations / `prisma db push`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Auth ---
# 32+ char random secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs marketplace sessions (companies and contractors) only.
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# --- Admin console ---
# Administrators are NOT marketplace users. They live in their own table, sign
# in at /admin/login with their own cookie, and their sessions are database rows
# rather than tokens — so AUTH_SECRET plays no part in admin access and there is
# no admin secret to configure here.
#
# There is no self-service sign-up or password reset for the console, by design.
# Provision the first administrator from a shell, once, and every subsequent one
# from /admin/team inside the console:
#
#   npm run admin:create
#
# The variables below are read by that script only. They are not read by the
# application at runtime, and you do not need them in a deployed environment —
# set them only for a scripted, non-interactive provision, and prefer letting
# the script generate the password.
#
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_NAME="Platform Administrator"
# ADMIN_CODE="WF-ADM-001"
# ADMIN_ROLE="SUPER_ADMIN"          # SUPER_ADMIN | VERIFIER (first account is always SUPER_ADMIN)
# ADMIN_PASSWORD=""                 # omit to have a strong one generated and printed once

# --- Platform ---
PLATFORM_NAME="WorkForge"
# Canonical public origin. Used for metadataBase, robots.txt and the sitemap, all
# of which need absolute URLs. Falls back to the Vercel URL, then localhost.
NEXT_PUBLIC_SITE_URL="https://workforge.in"

# No payment provider is integrated. WorkForge takes no commission and processes
# no money — companies and contractors invoice each other directly.

# Verification documents are stored in the database (Document.data), so no
# object storage / upload directory is needed.

# --- Email notifications (optional in dev, REQUIRED in production) ---
# In-app notifications always work. Set BOTH of these to also deliver the
# important ones by email (proposals, invites, awards, verification outcomes —
# never chat messages). Leave either unset and email stays completely inert:
# no provider call, not even a user lookup.
#
# Password reset and email confirmation are the exception: with no provider
# configured their links are written to the server log instead of being sent,
# which is fine locally and useless to a real user. A production deployment
# without these two set has no way for anyone to recover an account.
# Resend API key: https://resend.com/api-keys
# RESEND_API_KEY=""
# Must be a domain you have verified with the provider.
# EMAIL_FROM="WorkForge <notifications@workforge.in>"

# --- SMS / WhatsApp (not wired) ---
# Mobile numbers are collected but OTP delivery is not implemented.
# MSG91_AUTH_KEY=""

# --- Google sign-in (optional) ---
# Both must be set or the Google button does not render and the routes refuse.
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this exact
# Authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback     (local)
#   https://YOUR-DOMAIN/api/auth/google/callback       (production)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
