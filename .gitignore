*.log
.DS_Store

# env
.env
.env*.local
# `npm run db:local` parks the previous config here while it switches to the
# Docker database. These hold the hosted connection string and AUTH_SECRET —
# real credentials sitting in the working tree under an innocuous extension.
.env*.bak

# prisma sqlite db + uploads (runtime data)
/prisma/*.db
/prisma/*.db-journal
/data

# local tooling binary (downloaded, not part of source)
/cloudflared.exe

.vercel

# build cache
tsconfig.tsbuildinfo
